APP_NAME=HIMAL-RIDE API
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1

SECRET_KEY=dev-secret-key-not-for-production-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Use aiosqlite for async SQLite support
DATABASE_URL=sqlite+aiosqlite:///./himalride.db

CORS_ORIGINS=["http://localhost:5173"]
CORS_ALLOW_CREDENTIALS=true

LOG_LEVEL=INFO
JSON_LOGS=false